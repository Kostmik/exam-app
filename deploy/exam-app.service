[Unit]
Description=ExamApp ASP.NET Core Web API
After=network.target

[Service]
WorkingDirectory=/var/www/app
ExecStart=/usr/bin/dotnet /var/www/app/ExamApp.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=exam-app
User=www-data
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target
